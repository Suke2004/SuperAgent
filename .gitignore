# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
# Agent scratch space and git worktrees.
.claude/
# This project is pnpm-only (pnpm-lock.yaml is the committed lockfile). A stray
# package-lock.json means someone ran npm and resolved a different tree.
package-lock.json
yarn.lock

# Expo
.expo/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*
!.env.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# tests
coverage/

# Secrets: the API key lives in the Android Keystore via expo-secure-store and
# must never reach the repo. These patterns are belt-and-braces for local
# scratch files used while probing the gateway.
secrets/
*.token
*.secret
gateway-key*

# Expo export output. The `dist-web-*` and `.tmp-web-export` patterns exist
# because four such directories were committed once (debt D-01): `expo export`
# writes wherever `--output-dir` says, and a build artefact in the tree makes
# `git status` useless and invites committing 8 MB of bundled JavaScript.
.expo-export/
dist/
dist-web*/
.tmp-web-export/

# Build outputs. `eas build --local` and `expo run:android` both drop an installable
# next to the project, and an APK is ~60 MB of generated bytes.
*.apk
*.aab
*.aar
.eas/

# Signing and store credentials. A keystore in the repo is the app's identity, and
# `credentials.json` carries its passwords in plain text.
*.keystore
credentials.json

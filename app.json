{
  "expo": {
    "name": "Jarvis",
    "slug": "agentrouter-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "jarvis",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#262624"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "org.lyric.agentrouter",
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#262624",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Jarvis needs your photo library to attach an image to a message. Attachments stay on this device until you press send.",
          "cameraPermission": "Jarvis needs the camera to attach a photo to a message. The photo stays on this device until you press send."
        }
      ],
      "./plugins/with-no-backup.js"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1203a4d2-78ca-407d-a3fb-058ee83ceb50"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/1203a4d2-78ca-407d-a3fb-058ee83ceb50"
    },
    "ios": {}
  }
}
